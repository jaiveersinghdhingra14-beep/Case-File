# ==============================================================================
# CaseFile v2 (Big-Log Edition) Configuration (.env)
# ==============================================================================

# Application Environment
APP_NAME="CaseFile v2: Big-Log Edition"
APP_VERSION="2.0.0"
DEBUG=false

# LLM Configuration (Groq Ultra-Fast 70B/120B OSS Inference)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
USE_MOCK_LLM=false
MAX_LLM_CALLS=200

# Storage & Engine Paths
DATABASE_PATH=casefile_meta.db
PARQUET_STORAGE_DIR=data/parquet
MAX_RAM_BUDGET_GB=8.0
DEFAULT_CHUNK_SIZE=20

# Ingestion & Reduction Tuning
DEFAULT_SEED_TOP_K=2000
DEFAULT_EXPANSION_HOPS=2
DEFAULT_EXPANSION_WINDOW_SECONDS=120
DEFAULT_GROUP_GAP_SECONDS=60
