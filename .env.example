# ==============================================================================
# CaseFile Configuration (.env)
# ==============================================================================

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash
USE_MOCK_LLM=false

# Target Machine (Authorized Lab VM only)
TARGET_ID=lab-vm-01
TARGET_DISPLAY_NAME=Lab VM 01 (Ubuntu 22.04)
TARGET_HOST_NAME=ubuntu-lab-01
TARGET_OS=Ubuntu 22.04
TARGET_AUTHORIZED=true

# SSH Credentials for Lab VM
SSH_HOST=192.168.56.101
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_PATH=~/.ssh/id_rsa
DRY_RUN=false

# Log Source Configuration
# Options:
#   A = Wazuh archive file (/var/ossec/logs/archives/archives.json) - Default
#   B = Wazuh indexer (OpenSearch on port 9200)
#   C = Raw auditd file (/var/log/audit/audit.log over SSH)
LOG_SOURCE=A
WAZUH_ARCHIVE_PATH=/var/ossec/logs/archives/archives.json
WAZUH_INDEXER_URL=http://localhost:9200
RAW_AUDITD_PATH=/var/log/audit/audit.log

# Database
DATABASE_PATH=casefile.db
